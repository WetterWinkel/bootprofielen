// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model BoatTransfer {
  id             String   @id @default(cuid())
  shop           String
  profileId      String
  fromCustomerId String
  codeHash       String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([shop, profileId])
  @@index([expiresAt])
}

enum ServiceBookStatus {
  COMPLETED
  PLANNED
}

model ServiceBookEntry {
  id               String            @id @default(cuid())
  shop             String
  customerId       String
  profileId        String
  status           ServiceBookStatus @default(COMPLETED)
  serviceDate      DateTime
  category         String
  component        String?
  title            String
  description      String
  engineHours      Int?
  performedBy      String?
  partsMaterials   String?
  reference        String?
  costCents        Int?
  nextServiceHours Int?
  nextServiceDate  DateTime?
  reminderEnabled  Boolean           @default(true)
  attachments      Json              @default("[]")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([shop, customerId, profileId, serviceDate])
  @@index([shop, profileId])
  @@index([nextServiceDate])
}

enum CaptainMessageRole {
  USER
  ASSISTANT
}

enum CaptainUsageType {
  FREE
  CREDIT
}

model CaptainConversation {
  id                 String           @id @default(cuid())
  shop               String
  customerId         String
  profileId          String
  channel            String           @default("ACCOUNT")
  boatContext        Json             @default("{}")
  title              String
  improvementConsent Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  messages           CaptainMessage[]

  @@index([shop, customerId, profileId, updatedAt])
  @@index([shop, updatedAt])
}

model CaptainMessage {
  id             String              @id @default(cuid())
  conversationId String
  role           CaptainMessageRole
  content        String
  sources        Json                @default("[]")
  products       Json                @default("[]")
  feedback       Int?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  usageType      CaptainUsageType?
  createdAt      DateTime            @default(now())
  conversation   CaptainConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([feedback])
}

model CaptainCreditBalance {
  shop       String
  customerId String
  credits    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([shop, customerId])
}

model CaptainCreditPurchase {
  id           String    @id @default(cuid())
  shop         String
  customerId   String
  credits      Int
  priceCents   Int
  paymentToken String    @unique
  draftOrderId String?   @unique
  paidOrderId  String?   @unique
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([shop, customerId, createdAt])
}

enum BoatListingStatus {
  DRAFT
  AWAITING_PAYMENT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SOLD
  EXPIRED
}

model BoatListing {
  id              String               @id @default(cuid())
  shop            String
  customerId      String
  profileId       String
  slug            String               @unique
  status          BoatListingStatus    @default(DRAFT)
  title           String
  description     String
  priceCents      Int
  currency        String               @default("EUR")
  sellerType      String
  vatStatus       String
  location        String
  publicData      Json
  photos          Json
  coverPhotoUrl   String?
  paymentToken    String?              @unique
  draftOrderId    String?              @unique
  paidOrderId     String?              @unique
  paidAt          DateTime?
  publishedAt     DateTime?
  expiresAt       DateTime?
  soldAt          DateTime?
  rejectionReason String?
  termsAcceptedAt DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  inquiries       BoatListingInquiry[]
  reports         BoatListingReport[]

  @@index([shop, customerId, updatedAt])
  @@index([shop, status, publishedAt])
  @@index([profileId])
  @@index([expiresAt])
}

model BoatListingInquiry {
  id        String      @id @default(cuid())
  listingId String
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime    @default(now())
  listing   BoatListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
}

model BoatListingReport {
  id         String      @id @default(cuid())
  listingId  String
  name       String
  email      String
  reason     String
  details    String
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?
  listing    BoatListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([resolvedAt])
}
